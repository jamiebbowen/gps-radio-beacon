        -:    4: *
        -:    5: * Provides CHECK / CHECK_NEAR assertion macros, a TEST() declaration helper,
        -:    6: * and the fake HAL tick used by the stm32f4xx_hal.h stub. Include once per
        -:    7: * test executable and finish main() with TEST_SUMMARY().
        -:    8: */
        -:    9:
        -:   10:#ifndef TEST_HARNESS_H
