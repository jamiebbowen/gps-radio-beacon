        -:   39:/* Fake HAL tick backing the stubs/stm32f4xx_hal.h declarations. Defined
        -:   40: * here (once per test executable) so every test binary links cleanly. */
        -:   41:static uint32_t fake_tick_ms = 0;
        -:   42:/* On real hardware the systick ISR advances the tick even while code spins
        -:   43: * in a wait loop making no HAL calls. Tests that exercise such loops set
        -:   44: * this to the per-call quantum (e.g. 25) so timeouts can fire; default 0
        -:   45: * keeps the tick fully deterministic for everything else. */
        -:   46:static uint32_t fake_tick_auto_ms = 0;
