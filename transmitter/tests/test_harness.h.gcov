        -:   17:static int tests_run = 0;
        -:   18:static int tests_failed = 0;
        -:   19:
        -:   20:#define CHECK(cond) do {                                                   \
        -:   21:    tests_run++;                                                           \
        -:   22:    if (!(cond)) {                                                         \
        -:   23:        tests_failed++;                                                    \
        -:   24:        printf("  FAIL %s:%d: %s\n", __FILE__, __LINE__, #cond);           \
        -:   25:    }                                                                      \
        -:   26:} while (0)
        -:   27:
        -:   28:#define CHECK_NEAR(a, b, tol) CHECK(fabs((double)(a) - (double)(b)) <= (tol))
