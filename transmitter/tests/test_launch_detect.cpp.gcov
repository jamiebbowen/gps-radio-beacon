        2:  557:TEST(test_landing_survives_canopy_multipath_glitches)
        -:  558:{
        -:  559:    /* Recovery killer this guards: rocket at rest under tree canopy or in
        -:  560:     * a gully, GPS altitude reporting honest jitter plus 20-30 m multipath
        -:  561:     * spikes every ~15-60 s. One spike used to reset the 60 s stability
        -:  562:     * window forever - the landing never latches, and the beacon burns the
        -:  563:     * recovery-window power budget overnight. Isolated spikes must not
        -:  564:     * reset the window; sustained out-of-window readings still must. */
        1:  565:    reset_all();
        1:  566:    launch_detect_init();
        1:  567:    launch_detect_force_confirmed(4);
        -:  568:
        1:  569:    total_accel = 0.5f;
        1:  570:    uint32_t t = 500;
        1:  571:    uint32_t window_start = 0;
        1:  572:    bool landed = false;
       76:  573:    for (int i = 0; i < 75; i++, t++) {
       75:  574:        float alt = 500.0f + (float)((i % 2) ? 4 : -4);     /* honest jitter */
       75:  575:        if (i == 25 || i == 55) alt = 535.0f;              /* canopy spikes */
       75:  576:        landed = landing_detect_update(alt, true, t) || landed;
        -:  577:    }
       1*:  578:    CHECK(landed);
       1*:  579:    CHECK(launch_detect_has_landed() == true);
        -:  580:
        -:  581:    /* Control: the same spikes must NOT become a general tolerance for
        -:  582:     * movement - two consecutive out-of-window readings mean the rocket
        -:  583:     * is still sliding/rolling and the window really does restart. */
        1:  584:    reset_all();
        1:  585:    launch_detect_init();
        1:  586:    launch_detect_force_confirmed(4);
        -:  587:
        1:  588:    total_accel = 0.5f;
        1:  589:    landed = false;
        1:  590:    t = 700;
       51:  591:    for (int i = 0; i < 50; i++, t++) {
       50:  592:        landing_detect_update(500.0f, true, t);           /* near-complete window */
        -:  593:    }
        -:  594:    /* Rocket slides downhill for a while, then stops again */
        7:  595:    for (int i = 0; i < 6; i++, t++) {
        6:  596:        landing_detect_update(500.0f - 3.0f * i, true, t);
        -:  597:    }
       63:  598:    for (int i = 0; i < LAND_QUIET_S + 2; i++, t++) {
       62:  599:        landed = landing_detect_update(482.0f, true, t) || landed;
        -:  600:    }
       1*:  601:    CHECK(landed);                                       /* latched from RESTART */
        -:  602:    (void)window_start;
        1:  603:}
------------------
