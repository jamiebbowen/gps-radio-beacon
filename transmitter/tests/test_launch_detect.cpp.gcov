        2:  401:TEST(test_gps_fallback_resettles_after_long_outage)
        -:  402:{
        -:  403:    /* A re-acquired fix after a long outage is a fresh cold start: the
        -:  404:     * armed fallback would have counted its +67 m correction as climb.
        -:  405:     * Any gap past the settle window disarms the climb test again. */
        1:  406:    reset_all();
        1:  407:    launch_detect_init();
        -:  408:
        1:  409:    launch_detect_gps_fallback_update(1667.0f, 10);
       21:  410:    for (uint32_t t = 11; t <= 30; t++)
       20:  411:        launch_detect_gps_fallback_update(1667.0f, t);              /* armed */
        -:  412:
        -:  413:    /* An hour of darkness, then a cold fix 67 m below baseline */
       1*:  414:    CHECK(launch_detect_gps_fallback_update(1600.0f, 3610) == false);
       20:  415:    for (uint32_t t = 3611; t <= 3629; t++) {
      19*:  416:        CHECK(launch_detect_gps_fallback_update(1667.0f, t) == false);
        -:  417:    }
       1*:  418:    CHECK(launch_detect_get_state() != LAUNCH_STATE_CONFIRMED);
        -:  419:    /* Settle completes at first+20; climbs count again afterwards */
       1*:  420:    CHECK(launch_detect_gps_fallback_update(1718.0f, 3631) == false); /* climb 1 */
        1:  421:}
------------------
