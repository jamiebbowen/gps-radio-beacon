        -:  337:
        2:  338:TEST(test_gps_fallback_cold_start_low_baseline_no_false_launch)
        -:  339:{
        -:  340:    /* THE false-launch bug this redesign fixes: a GPS cold start reads
        -:  341:     * ~80 m LOW, then corrects over the next seconds. The sustained +80 m
        -:  342:     * "climb" back to truth confirmed a launch that never happened under
        -:  343:     * the first-fix baseline. During settle the correction just feeds the
        -:  344:     * max. */
        1:  345:    reset_all();
        1:  346:    launch_detect_init();
        -:  347:
        1:  348:    launch_detect_gps_fallback_update(1587.0f, 10);   /* cold: -80 low */
        1:  349:    launch_detect_gps_fallback_update(1620.0f, 11);   /* correcting   */
        1:  350:    launch_detect_gps_fallback_update(1650.0f, 12);   /* correcting   */
       29:  351:    for (uint32_t t = 13; t <= 40; t++) {
      28*:  352:        CHECK(launch_detect_gps_fallback_update(1667.0f + (float)(t & 1), t)
        -:  353:              == false);
        -:  354:    }
        -:  355:    /* 28 s at the true altitude: the correction was absorbed, no launch */
       1*:  356:    CHECK(launch_detect_get_state() == LAUNCH_STATE_IDLE);
        1:  357:}
------------------
