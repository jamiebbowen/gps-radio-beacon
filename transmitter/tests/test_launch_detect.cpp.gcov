        2:  188:TEST(test_launch_detection_happy_path)
        -:  189:{
        1:  190:    reset_all();
        1:  191:    launch_detect_init();
        -:  192:
        -:  193:    /* Below threshold: nothing happens */
        1:  194:    push_accel(5, 0, 0);
        1:  195:    tick(10, 0);
       1*:  196:    CHECK(launch_detect_get_state() == LAUNCH_STATE_IDLE);
        -:  197:
        -:  198:    /* Above threshold: enters DETECTING but not yet confirmed */
        1:  199:    push_accel(25, 0, 0);
        1:  200:    tick(10, 0);
       1*:  201:    CHECK(launch_detect_get_state() == LAUNCH_STATE_DETECTING);
       1*:  202:    CHECK(launch_detect_is_launched() == false);
        -:  203:
        -:  204:    /* Sustained past LAUNCH_ACCEL_DURATION (100 ms): CONFIRMED */
        1:  205:    push_accel(25, 0, 0);
        1:  206:    tick(50, 0);
       1*:  207:    CHECK(launch_detect_get_state() == LAUNCH_STATE_DETECTING);
        1:  208:    push_accel(25, 0, 0);
        1:  209:    tick(50, 42);                                /* t=110 ms into detection */
       1*:  210:    CHECK(launch_detect_get_state() == LAUNCH_STATE_CONFIRMED);
       1*:  211:    CHECK(strstr(Serial.log, "LAUNCH CONFIRMED") != NULL);
        -:  212:
        -:  213:    /* is_launched is a one-shot flag */
       1*:  214:    CHECK(launch_detect_is_launched() == true);
       1*:  215:    CHECK(launch_detect_is_launched() == false);
        -:  216:
        -:  217:    /* Launch time latched from system_time_seconds */
       1*:  218:    CHECK(launch_detect_get_time_since_launch(42) == 0);
       1*:  219:    CHECK(launch_detect_get_time_since_launch(52) == 10);
        -:  220:
        -:  221:    /* Confirmed is terminal */
        1:  222:    push_accel(0, 0, 0);
        1:  223:    tick(100, 60);
       1*:  224:    CHECK(launch_detect_get_state() == LAUNCH_STATE_CONFIRMED);
        1:  225:}
