       1*:  374:    CHECK(launch_detect_gps_fallback_update(1800.0f, 32) == false);  /* climb 2 */
       1*:  375:    CHECK(launch_detect_gps_fallback_update(1801.0f, 33) == true);   /* climb 3 */
       1*:  376:    CHECK(launch_detect_get_state() == LAUNCH_STATE_CONFIRMED);
