        2:  379:TEST(test_gps_fallback_ignores_climb_before_arming)
        -:  380:{
        -:  381:    /* A launch inside the first 20 s of GPS life is the IMU's job; the
        -:  382:     * fallback's climb test is disarmed until the baseline settles, so
        -:  383:     * even a sustained +53 "climb" mid-settle can only feed the max. */
        1:  384:    reset_all();
        1:  385:    launch_detect_init();
        -:  386:
        1:  387:    launch_detect_gps_fallback_update(1667.0f, 10);
       20:  388:    for (uint32_t t = 11; t <= 29; t++) {
      19*:  389:        CHECK(launch_detect_gps_fallback_update(1720.0f, t) == false);
        -:  390:    }
       1*:  391:    CHECK(launch_detect_get_state() != LAUNCH_STATE_CONFIRMED);
        -:  392:
        -:  393:    /* The t=31 feed arms the test and ratchets baseline to 1770; the
        -:  394:     * armed climb test then needs >= 1820 sustained. */
       1*:  395:    CHECK(launch_detect_gps_fallback_update(1770.0f, 31) == false);
       1*:  396:    CHECK(launch_detect_gps_fallback_update(1821.0f, 32) == false);  /* climb 1 */
       1*:  397:    CHECK(launch_detect_gps_fallback_update(1822.0f, 33) == false);  /* climb 2 */
       1*:  398:    CHECK(launch_detect_gps_fallback_update(1823.0f, 34) == true);   /* climb 3 */
        1:  399:}
------------------
