      21*:  467:        CHECK(launch_detect_gps_fallback_update(1667.0f, t) == false);
        -:  468:    }
        -:  469:    /* NaN mid-stream is ignored too - baseline and arming survive. */
       1*:  470:    CHECK(launch_detect_gps_fallback_update(nan_f, 33) == false);
        -:  471:
       1*:  472:    CHECK(launch_detect_gps_fallback_update(1720.0f, 34) == false);  /* climb 1 */
       1*:  473:    CHECK(launch_detect_gps_fallback_update(1721.0f, 35) == false);  /* climb 2 */
       1*:  474:    CHECK(launch_detect_gps_fallback_update(1722.0f, 36) == true);   /* climb 3 */
       1*:  475:    CHECK(launch_detect_get_state() == LAUNCH_STATE_CONFIRMED);
        1:  476:}
