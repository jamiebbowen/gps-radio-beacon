(version 1)

// PCBWay standard (cheapest) 2-layer process:
// - min trace/space 0.15 mm (0.1 mm possible but costs extra)
// - min annular ring 0.15 mm, min drill 0.3 mm
// - copper-to-routed-edge >= 0.3 mm
// Board setup constraints in panel.kicad_pro carry the same limits; this
// file keeps the explicit clearance rule in sync with them.
(rule "PCBWay standard clearance"
  (constraint clearance (min 0.15mm)))
